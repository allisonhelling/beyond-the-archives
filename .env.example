VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional Connect Reader destination override; defaults to https://archivesunfolded.vercel.app/.
# Use HTTPS, or loopback HTTP for local development.
# VITE_READER_URL=https://your-reader.example.com
# Connected-login sibling origin, set in BOTH app builds when self-hosting.
# VITE_ORGANIZER_URL=https://your-organizer.example.com
# For the local reader: VITE_READER_URL=http://127.0.0.1:5174/

# Optional extension ID; can also be entered in Settings on each device.
# VITE_AO3_EXTENSION_ID=abcdefghijklmnopabcdefghijklmnop
# Build-time extension origin. Set to your exact hosted site, without a path.
# EXTENSION_APP_ORIGIN=https://your-library.example.com
# Local builds use npm run build:extension:local; this optional origin defaults to port 5173.
# EXTENSION_LOCAL_APP_ORIGIN=http://127.0.0.1:5173

# Server-only worker variables. Never prefix these with VITE_.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=server_only_replace_me
# IMPORT_WORKER_TOKEN=long_random_secret_for_scheduled_edge_calls_only
