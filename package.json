{
  "name": "beyond-the-archives",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:sample": "vite --host 127.0.0.1 --mode sample",
    "build": "tsc -b && vite build",
    "build:userscript": "node --experimental-strip-types scripts/build-userscript.mjs",
    "build:userscript:hosted": "npm run build:userscript --",
    "build:extension": "node --experimental-strip-types scripts/build-extension.mjs",
    "build:extension:local": "node --experimental-strip-types scripts/build-extension.mjs --local",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run src server",
    "test:db": "vitest run supabase/tests",
    "test:offline": "npm run build && playwright test --config playwright.offline.config.ts",
    "test:e2e": "playwright test",
    "check:security": "node scripts/check-security.mjs",
    "check": "npm run lint && npm run build && npm test && npm run test:integration:config && npm run check:security",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local --level warning",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "db:types:embedded": "node scripts/generate-test-types.mjs",
    "backup:restore": "node --env-file-if-exists=.env.worker server/restore-backup.mjs",
    "backup:prune": "node --env-file-if-exists=.env.worker --experimental-strip-types server/prune-backups.mjs",
    "invite": "node server/invite-user.mjs",
    "test:integration": "node scripts/test-supabase.mjs",
    "test:integration:config": "node --test scripts/tests/supabase-status.mjs",
    "worker": "node --env-file-if-exists=.env.worker --experimental-strip-types server/import-worker.ts",
    "perf:db": "node scripts/performance-library.mjs",
    "perf:backup": "node scripts/performance-backups.mjs",
    "perf:hosted": "node scripts/performance-hosted.mjs",
    "perf:browser": "playwright test performance.spec.ts --workers=1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.0",
    "cheerio": "^1.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.0.0",
    "jsdom": "^28.0.0",
    "supabase": "^2.76.0",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
