{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev --prefix .. && npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|sw[.]js$|icon[.]svg$|manifest[.]webmanifest$).*)",
      "destination": "/index.html"
    }
  ]
}
